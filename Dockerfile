# syntax=docker/dockerfile:1.7

# modusregel
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends emacs; \
    zypper clean --all

COPY modusregel.el ./

RUN set -eu; \
    emacs -Q --batch -f batch-byte-compile "modusregel.el"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="modusregel" \
      org.opencontainers.image.description="Mode line customizations for Emacs" \
      org.opencontainers.image.url="https://github.com/jjba23/modusregel" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends emacs; \
    zypper clean --all

COPY --from=builder /src/modusregel.el /usr/share/emacs/site-lisp/modusregel.el
COPY --from=builder /src/modusregel.elc /usr/share/emacs/site-lisp/modusregel.elc

ENTRYPOINT ["emacs"]
CMD ["-nw"]
