pkgname=emacs-modusregel
pkgver=0.7.1
pkgrel=1
pkgdesc="Mode line customizations for Emacs"
arch=('any')
url="https://codeberg.org/jjba23/modusregel"
license=('GPL-3.0-or-later')
depends=('emacs')
makedepends=('emacs')
checkdepends=('emacs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('72fd52007e2be842b8c6f8c3a9c77f97faa1d1a19472619448a9571cc997a997')

build() {
  cd "$srcdir/modusregel"

  emacs -Q --batch -f batch-byte-compile modusregel.el
}

# The terminal render test needs a TTY and times out in a build chroot, so the ERT suite is not run.
# check() omitted.

package() {
  cd "$srcdir/modusregel"

  install -Dm644 modusregel.el "$pkgdir/usr/share/emacs/site-lisp/modusregel.el"
  install -Dm644 modusregel.elc "$pkgdir/usr/share/emacs/site-lisp/modusregel.elc"

  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
  install -Dm644 NEWS.org "$pkgdir/usr/share/doc/$pkgname/NEWS.org"
}
